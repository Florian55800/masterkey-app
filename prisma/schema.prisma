datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  pin         String
  color       String
  photo       String?
  role        String   @default("")
  accessLevel String   @default("admin") // "admin" | "co-gestionnaire"
  createdAt   DateTime @default(now())
  teamGoals   TeamGoal[]
}

model Owner {
  id              Int                 @id @default(autoincrement())
  name            String
  phone           String?
  isWhatsapp      Boolean             @default(false)
  email           String?
  adresseDomicile String?
  notes           String?
  photo           String?
  lastContact     DateTime?
  relanceDate     DateTime?
  relanceNote     String?
  source          String?
  properties     Property[]
  satisfactions  SatisfactionScore[]
  advances       Advance[]
  onboarding     OwnerOnboarding?
  documents      OwnerDocument[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model OwnerOnboarding {
  id                    Int      @id @default(autoincrement())
  ownerId               Int      @unique
  owner                 Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Identité
  nomPrenom             String?
  adresseDomicile       String?
  telephone             String?
  // Logement
  villeLogement         String?
  adresseLogement       String?
  typeBien              String?
  arriveeAutonome       String?
  codeBoiteACles        String?
  surface               String?
  nbChambres            String?
  nbSallesBain          String?
  etage                 String?
  accessible            String?
  equipements           String?
  // Accès & pratique
  wifiNom               String?
  wifiMdp               String?
  consignesPoubelles    String?
  reglementInterieur    String?
  instructionsAppareils String?
  styleDecoration       String?
  themeParticularite    String?
  // Plateformes
  dejaEnLocation        String?
  lienAnnonce           String?
  disponibiliteMois     String?
  occupe                String?
  // Sécurité
  detecteurFumee        String?
  emplacementElectrique String?
  extincteur            String?
  piscine               String?
  // Financier
  prixMoyenNuit         String?
  tauxOccupation        String?
  revenusMenuels        String?
  fraisMensuels         String?
  maximiserRevenus      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OwnerDocument {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  url       String
  mimeType  String?
  size      Int?
  category  String   @default("autre")
  createdAt DateTime @default(now())
}

model Staff {
  id         Int        @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  role       String     @default("ménage")
  notes      String?
  photo      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  properties Property[]
}

model Property {
  id             Int               @id @default(autoincrement())
  name           String
  address        String
  city           String
  type           String
  typeGestion    String            @default("conciergerie")
  ownerId        Int
  owner          Owner             @relation(fields: [ownerId], references: [id])
  commissionRate Float
  cleaningFee    Float             @default(0)
  staffId        Int?
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  lodgifyId      Int?
  photo          String?
  description    String?
  keyboxCode     String?
  latitude       Float?
  longitude      Float?
  dateSigned     DateTime
  dateLost       DateTime?
  status         String            @default("active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  revenues       PropertyRevenue[]
  subletExpenses SubletExpense[]
  advances       Advance[]
  cleaningSheet  CleaningSheet?
  welcomeGuide   WelcomeGuide?
  checklist      PropertyChecklist?
}

model PropertyRevenue {
  id             Int      @id @default(autoincrement())
  propertyId     Int
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  platform       String   // "airbnb" | "booking" | "direct" | "autre"
  platformAmount Float    @default(0)
  cleaningFees   Float    @default(0)
  commissionRate Float    @default(0)
  notes          String?
  nbSejours      Int      @default(0)
  nbNuits        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([propertyId, month, year, platform])
}

model SubletExpense {
  id            Int      @id @default(autoincrement())
  propertyId    Int
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  loyer         Float    @default(0)
  electricite   Float    @default(0)
  wifi          Float    @default(0)
  autresCharges Float    @default(0)
  nbSejours     Int      @default(0)
  nbNuits       Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([propertyId, month, year])
}

model SatisfactionScore {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  owner     Owner    @relation(fields: [ownerId], references: [id])
  score     Int
  quarter   Int
  year      Int
  createdAt DateTime @default(now())
}

model MonthlyReport {
  id               Int       @id @default(autoincrement())
  month            Int
  year             Int
  caBrut           Float     @default(0)
  commissions      Float     @default(0)
  activeProperties Int       @default(0)
  totalNights      Int       @default(0)
  newSignatures    Int       @default(0)
  lostProperties   Int       @default(0)
  netProfit        Float     @default(0)
  notes            String?
  targetMargin     Float?
  isPlaceholder    Boolean   @default(false)
  expenses         Expense[]
  teamGoals        TeamGoal[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@unique([month, year])
}

model Expense {
  id          Int           @id @default(autoincrement())
  reportId    Int
  report      MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category    String
  description String?
  amount      Float
  isRecurring Boolean       @default(false)
  payDate     DateTime?
  paymentDay  Int?
  createdAt   DateTime      @default(now())
}

model TeamGoal {
  id               Int           @id @default(autoincrement())
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  reportId         Int
  report           MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  propertiesSigned Int           @default(0)
  appointmentsMade Int           @default(0)
  personalGoal     String?
  goalStatus       String        @default("en_cours")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  @@unique([userId, reportId])
}

model MonthlyObjective {
  id                  Int      @id @default(autoincrement())
  month               Int      // 0 = objectif annuel
  year                Int
  targetLeads         Int      @default(0)
  targetSignatures    Int      @default(0)
  targetVisites       Int      @default(0)
  targetAppels        Int      @default(0)
  targetCAParLogement Float    @default(0)
  targetLogements     Int      @default(0)
  actualLeads         Int      @default(0)
  actualSignatures    Int      @default(0)
  actualVisites       Int      @default(0)
  actualAppels        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([month, year])
}

model City {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(false)
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Advance {
  id          Int       @id @default(autoincrement())
  description String
  amount      Float
  ownerId     Int?
  owner       Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  propertyId  Int?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status      String    @default("en_attente") // "en_attente" | "rembourse"
  date        DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CleaningSheet {
  id           Int      @id @default(autoincrement())
  propertyId   Int      @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  instructions String?
  checklist    String   @default("[]") // JSON [{id,label,isDefault}]
  mediaUrls    String   @default("[]") // JSON ["/uploads/cleaning/xxx.jpg"]
  shareToken   String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WelcomeGuide {
  id             Int      @id @default(autoincrement())
  propertyId     Int      @unique
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shareToken     String   @unique @default(cuid())
  welcomeMessage String?
  wifiName       String?
  wifiPassword   String?
  keyCode        String?
  checkIn        String?
  checkOut       String?
  houseRules     String   @default("[]")
  restaurants    String   @default("[]")
  activities     String   @default("[]")
  customSections String   @default("[]")
  mediaUrls      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PropertyChecklist {
  id           Int      @id @default(autoincrement())
  propertyId   Int      @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  consommables String   @default("[]") // JSON string[] of checked item IDs
  equipements  String   @default("[]") // JSON string[] of checked item IDs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OnboardingSession {
  id        String   @id @default(cuid())
  name      String
  type      String   // "conciergerie" | "souslocation"
  checks    String   @default("{}") // JSON Record<taskId, boolean>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id             Int       @id @default(autoincrement())
  name           String
  contrepartie   String?
  type           String    @default("autre")
  dateSigne      DateTime?
  dateExpiration DateTime?
  dureePreavis   Int?      // jours avant expiration pour alerte
  statut         String    @default("actif") // "actif" | "expire" | "resilie"
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Lead {
  id           Int       @id @default(autoincrement())
  nom          String
  email        String?
  telephone    String?
  adresseBien  String?
  ville        String?
  typeBien     String?
  nbChambres   String?
  surface      Float?
  lienAnnonce  String?
  adresseDomicile String?
  isWhatsapp      Boolean   @default(false)
  statut       String    @default("À contacter")
  statuts      String?   // JSON array e.g. '["Signé","Visite effectuée"]'
  source       String?
  commentaires String?
  dateContact  DateTime  @default(now())
  relanceDate  DateTime?
  relanceNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  visits       Visit[]
}

model Visit {
  id        Int      @id @default(autoincrement())
  leadId    Int?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  date      DateTime
  address   String
  notes     String?
  createdAt DateTime @default(now())
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   @default("autre")
  month     Int
  year      Int
  createdAt DateTime @default(now())
}

model Simulation {
  id           Int      @id @default(autoincrement())
  name         String   @default("Ma simulation")
  revenues     String   @default("[]")
  expenses     String   @default("[]")
  salary       Float    @default(0)
  loanTotal    Float    @default(10000)
  loanRemaining Float   @default(10000)
  loanMonthly  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prestataire {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  city       String?
  categories String   @default("[]")
  services   String?
  source     String?
  notes      String?
  isWhatsapp Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
